generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String @id @default(uuid())
  userName    String
  phoneNumber String @unique

  orders Order[]
}

model Inventory {
  id           String      @id @default(uuid())
  name         String
  veg          Boolean
  stock        Boolean
  description  String
  category     Category    @relation(fields: [categoryName], references: [categoryName])
  pricePerItem Int
  orderItems   OrderItem[]
  categoryName String
}

model Category {
  categoryName String      @id
  Inventory    Inventory[]
}

model Order {
  orderID    String      @id
  status     OrderStatus @default(CONFIRMED)
  orderItems OrderItem[]
  totalPrice Int
  createdAt  DateTime    @default(now())

  ownerID String
  user    User   @relation(fields: [ownerID], references: [id])
}

model OrderItem {
  id        String @id @default(uuid())
  frequency Int

  inventoryID String
  inventory   Inventory @relation(fields: [inventoryID], references: [id])

  orderID String
  order   Order  @relation(fields: [orderID], references: [orderID])

  @@unique([orderID, inventoryID])
}

enum OrderStatus {
  CONFIRMED
  DELIVERED
}
